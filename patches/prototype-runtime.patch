+static inline int psp_pose_matrix(const float *a,const float *b,float alpha,float *o){
+ float axes[3][3],scale[3],sign=1;
+ for(int k=0;k<3;k++){
+  float x[3],y[3];for(int i=0;i<3;i++){x[i]=a[k*3+i];y[i]=b[k*3+i];}
